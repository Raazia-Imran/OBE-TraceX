# Copy to .env for Docker only. Local manage.py uses shell environment variables.
# Generate independent real secrets locally; never commit the populated .env.
OBE_ENV=production
DJANGO_SECRET_KEY=
OBE_MFA_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_ORIGINS=https://replace-with-approved-domain
TRUST_PROXY=1
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=obe_tracex
POSTGRES_USER=obe_portal
POSTGRES_PASSWORD=
N8N_WEBHOOK_SECRET=
GOOGLE_WORKBOOK_ID=
# Optional: mount credentials at this path in a private Compose override.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-credentials.json
